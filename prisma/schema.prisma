generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Category {
  CLOTHING
  SHOES
  BAGS
  FRAGRANCE
  SALES
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

enum Size {
  S
  M
  L
  XL
  XXL
  XXXL
  SIZE_10
  SIZE_12
  SIZE_14
  SIZE_16
  SIZE_18
  SHOE_4_37
  SHOE_5_38
  SHOE_6_39
  SHOE_7_40
  SHOE_8_41
  SHOE_9_42
  SHOE_10_43
  SHOE_11_44
}

enum ClothingSubcategory {
  BLOUSE
  T_SHIRT
  SHIRT
  DRESS
  TROUSERS
  BLAZERS
  SKIRTS
  JUMPSUITS
  JEANS
  TWO_PIECE
}

model Product {
  id          String         @id @default(cuid())
  name        String
  slug        String         @unique
  description String
  price       Decimal        @db.Decimal(10, 2)
  category    Category
  // Only meaningful when category is CLOTHING — enforced in application
  // code (actions/products.ts), not at the schema level.
  subcategory ClothingSubcategory?
  // Single source of truth for stock. "In stock" / "out of stock" is ALWAYS
  // derived from this (quantity > 0) in application code — never stored as
  // a separate flag, so it can never drift out of sync.
  // Source of truth for CLOTHING products with no sizes defined below. Once
  // a product has ProductSize rows, this is kept in sync as their sum — see
  // the comment in actions/products.ts — so "in stock" checks elsewhere in
  // the app never need to know whether a product uses sizes.
  quantity    Int            @default(0)
  badge       String?
  images      ProductImage[]
  sizes       ProductSize[]
  orderItems  OrderItem[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([category])
}

model ProductSize {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      Size
  quantity  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
  @@index([productId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id              String        @id @default(cuid())
  customerName    String
  customerPhone   String?
  customerEmail   String?
  deliveryAddress String
  notes           String?
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(UNPAID)
  // Sum of line items at creation time. Always re-derivable from OrderItem
  // as a sanity check; never mutated after creation.
  totalAtOrder    Decimal       @db.Decimal(10, 2)
  items           OrderItem[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model OrderItem {
  id                  String   @id @default(cuid())
  orderId             String
  order               Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Nullable + SetNull so an order's history survives the product being
  // edited or deleted later.
  productId           String?
  product             Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productNameAtOrder  String
  productImageAtOrder String?
  // Snapshot display label ("M", "10"), not a live Size reference — same
  // reasoning as the fields above: an order's history must survive the
  // product's sizes being edited or removed later.
  sizeAtOrder         String?
  // NEVER re-read the live Product.price for historical orders — prices
  // change, this snapshot is what the customer actually agreed to.
  unitPriceAtOrder    Decimal  @db.Decimal(10, 2)
  quantity            Int

  @@index([orderId])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String
  createdAt DateTime @default(now())
}
