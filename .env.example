# Database (DigitalOcean Managed PostgreSQL in production; any Postgres locally,
# e.g. a free Neon project). DIRECT_URL is a non-pooled connection used only for
# running migrations — if your provider doesn't distinguish pooled vs. direct
# connections, set both to the same value.
DATABASE_URL="postgresql://user:password@host:25060/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:25060/dbname?sslmode=require"

# DigitalOcean Spaces (S3-compatible object storage, used for product images)
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=nyc3
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# Optional: set if you enable a Spaces CDN endpoint. Leave blank to use the
# default <bucket>.<region>.digitaloceanspaces.com URL.
SPACES_CDN_URL=

# Email notifications (Resend)
RESEND_API_KEY=
OWNER_NOTIFICATION_EMAIL=shop@totalbellasgh.com

# Admin auth
ADMIN_PASSWORD=
# A long random string, e.g. generate with: openssl rand -hex 32
SESSION_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
